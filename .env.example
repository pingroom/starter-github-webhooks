# Copy to .env. Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the same secret in GitHub repository Settings > Webhooks.
GITHUB_WEBHOOK_SECRET=
# Required comma-separated owner/repository allowlist.
GITHUB_REPOSITORIES=your-org/your-repo
# Connect with npm run connect OR uncomment and supply BOTH variables.
# PINGROOM_TOKEN=
# PINGROOM_ROOM=
# A reverse proxy or tunnel must expose /webhooks/github over HTTPS.
HOST=127.0.0.1
PORT=3000
